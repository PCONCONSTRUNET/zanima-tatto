// ZANIMA TATTOO — Schema PostgreSQL + Prisma ORM
// Desenvolvido pela P-CON CONSTRUNET

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  STAFF
  CLIENT
}

enum ThemePreference {
  LIGHT
  DARK
}

enum LgpdRequestType {
  EXPORT
  ANONYMIZATION
  CONSENT_REVOKE
}

enum LgpdRequestStatus {
  PENDING
  COMPLETED
  REJECTED
}

enum LinkRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AppointmentStatus {
  REQUESTED
  AWAITING_CONFIRMATION
  AWAITING_DEPOSIT
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum BlockType {
  MANUAL
  HOLIDAY
  PERSONAL
}

enum ProjectStage {
  INITIAL_IDEA
  QUOTING
  AWAITING_APPROVAL
  ART_DEVELOPMENT
  ART_APPROVED
  SESSION_SCHEDULED
  IN_EXECUTION
  HEALING
  COMPLETED
}

enum QuoteStatus {
  NEW
  ANALYZING
  SENT
  APPROVED
  DECLINED
  EXPIRED
  CONVERTED
}

enum MediaKind {
  REFERENCE
  ARTWORK
  RESULT_PHOTO
  HEALING_PHOTO
}

enum AftercareStatus {
  NORMAL
  REVIEW_REQUESTED
  TOUCHUP_REQUESTED
  MEDICAL_ADVISED
}

enum FinancialContext {
  STUDIO
  PERSONAL
}

enum AccountType {
  BANK
  CASH
  DIGITAL_WALLET
  RESERVE
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionStatus {
  PAID
  RECEIVED
  PENDING
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD
  CASH
  BANK_TRANSFER
}

enum TransferKind {
  OWNER_WITHDRAWAL
  RESERVE_DEPOSIT
  ACCOUNT_TRANSFER
}

enum PaymentKind {
  DEPOSIT
  PARTIAL
  FULL
}

enum GatewayProvider {
  MANUAL
  MERCADO_PAGO
  EFI_BANK
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
  CANCELLED
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
}

enum DocumentKind {
  ANAMNESIS
  CONSENT
  IMAGE_AUTHORIZATION
  CANCELLATION_POLICY
  LIABILITY_TERM
  CUSTOM
}

enum FileVisibility {
  PUBLIC_PORTFOLIO
  CLIENT_OWNED
  ADMIN_PRIVATE
}

enum DiscountType {
  PERCENT
  FIXED
}

enum ReferralStatus {
  INVITED
  CONVERTED
  REWARDED
}

enum VoucherStatus {
  ACTIVE
  REDEEMED
  EXPIRED
}

enum FlashStatus {
  AVAILABLE
  RESERVED
  TATTOOED
}

enum WaitlistStatus {
  WAITING
  NOTIFIED
  BOOKED
  ARCHIVED
}

enum NotificationChannel {
  IN_APP
  WHATSAPP
  EMAIL
  PUSH
}

enum NotificationStatus {
  UNREAD
  READ
  QUEUED
  SKIPPED_UNCONFIGURED
  FAILED
}

enum IntegrationProvider {
  WHATSAPP
  EMAIL
  PUSH
  MERCADO_PAGO
  EFI_BANK
}

model User {
  id                  String          @id @default(cuid())
  name                String
  email               String          @unique
  passwordHash        String
  role                UserRole        @default(CLIENT)
  permissions         Json            @default("{}")
  themePreference     ThemePreference @default(DARK)
  hideFinancialValues Boolean         @default(false)
  active              Boolean         @default(true)
  lastLoginAt         DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  sessions              AuthSession[]
  passwordResets        PasswordResetToken[]
  clientProfile         Client?
  clientLinkRequests    ClientLinkRequest[]    @relation("UserLinkRequests")
  reviewedLinkRequests  ClientLinkRequest[]    @relation("ReviewedLinkRequests")
  clientNotesAuthored   ClientNote[]
  artistAppointments    Appointment[]          @relation("ArtistAppointments")
  appointmentChanges    AppointmentHistory[]
  availabilityBlocks    AvailabilityBlock[]
  reminders             Reminder[]
  noteFolders           NoteFolder[]
  studioNotes           StudioNote[]
  financialAccounts     FinancialAccount[]
  creditCards           CreditCard[]
  financialCategories   FinancialCategory[]
  financialTransactions FinancialTransaction[]
  internalTransfers     InternalTransfer[]
  financialGoals        FinancialGoal[]
  confirmedPayments     Payment[]              @relation("ConfirmedPayments")
  stockMovements        StockMovement[]
  uploadedFiles         StoredFile[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  lgpdRequests          LgpdRequest[]
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String
  beforeJson  Json?
  afterJson   Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
}

model LgpdRequest {
  id          String            @id @default(cuid())
  clientId    String?
  userId      String?
  type        LgpdRequestType
  status      LgpdRequestStatus @default(PENDING)
  notes       String?
  requestedAt DateTime          @default(now())
  completedAt DateTime?

  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([status])
}

model Client {
  id                       String    @id @default(cuid())
  userId                   String?   @unique
  fullName                 String
  phone                    String
  whatsapp                 String
  email                    String?
  birthDate                DateTime? @db.Date
  cpfLast4                 String?
  identityVerificationCode String?
  avatarFileId             String?
  preferredStyles          String[]  @default([])
  allergiesSummary         String?
  marketingOptIn           Boolean   @default(false)
  lgpdConsentAt            DateTime?
  isAnonymized             Boolean   @default(false)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  user                 User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  linkRequests         ClientLinkRequest[]
  notes                ClientNote[]
  appointments         Appointment[]
  projects             TattooProject[]
  quoteRequests        QuoteRequest[]
  passports            TattooPassport[]
  aftercareEntries     AftercareEntry[]
  futureIdeas          FutureTattooIdea[]
  payments             Payment[]
  documentSignatures   DocumentSignature[]
  storedFiles          StoredFile[]
  referralsMade        Referral[]            @relation("ReferrerClient")
  referralsReceived    Referral[]            @relation("ReferredClient")
  reservedFlashes      ExclusiveFlashDesign[]
  waitlistEntries      WaitlistEntry[]
  lgpdRequests         LgpdRequest[]

  @@index([fullName])
  @@index([email])
  @@index([whatsapp])
}

model ClientLinkRequest {
  id                String            @id @default(cuid())
  userId            String
  targetClientId    String
  providedEmail     String?
  providedPhone     String?
  providedBirthDate String?
  status            LinkRequestStatus @default(PENDING)
  reviewedByUserId  String?
  reviewedAt        DateTime?
  notes             String?
  createdAt         DateTime          @default(now())

  user         User   @relation("UserLinkRequests", fields: [userId], references: [id], onDelete: Cascade)
  targetClient Client @relation(fields: [targetClientId], references: [id], onDelete: Cascade)
  reviewedBy   User?  @relation("ReviewedLinkRequests", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([status])
}

model ClientNote {
  id           String   @id @default(cuid())
  clientId     String
  authorUserId String
  content      String
  isPrivate    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([clientId])
}

model AvailabilityRule {
  id              String   @id @default(cuid())
  dayOfWeek       Int      @unique // 0 = Domingo .. 6 = Sábado
  startTime       String   // HH:mm
  endTime         String   // HH:mm
  slotStepMinutes Int      @default(30)
  bufferMinutes   Int      @default(15)
  isActive        Boolean  @default(true)
  updatedAt       DateTime @updatedAt
}

model AvailabilityBlock {
  id              String    @id @default(cuid())
  title           String
  startAt         DateTime
  endAt           DateTime
  reason          String?
  blockType       BlockType @default(MANUAL)
  createdByUserId String?
  createdAt       DateTime  @default(now())

  createdBy User? @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([startAt, endAt])
}

model ServiceCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model StudioService {
  id              String        @id @default(cuid())
  category        String        @default("")
  name            String
  description     String?
  durationMinutes Int           @default(120)
  sessionsCount   Int           @default(1)
  price           Decimal       @default(0) @db.Decimal(12, 2)
  depositAmount   Decimal       @default(0) @db.Decimal(12, 2)
  isActive        Boolean       @default(true)
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  appointments    Appointment[]

  @@index([isActive, category])
}

model Appointment {
  id                     String            @id @default(cuid())
  codeNumber             Int               @unique @default(autoincrement())
  clientId               String
  projectId              String?
  serviceId              String?
  artistUserId           String
  title                  String
  description            String?
  startAt                DateTime
  endAt                  DateTime
  durationMinutes        Int
  bufferAfterMinutes     Int               @default(15)
  status                 AppointmentStatus @default(REQUESTED)
  sessionNumber          Int               @default(1)
  totalSessions          Int               @default(1)
  recurrenceGroupId      String?
  priceEstimate          Decimal?          @db.Decimal(12, 2)
  depositRequired        Decimal?          @db.Decimal(12, 2)
  preferredPaymentMethod PaymentMethod?
  clientNotes            String?
  internalNotes          String?
  confirmedAt            DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  client                Client                 @relation(fields: [clientId], references: [id], onDelete: Restrict)
  project               TattooProject?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  service               StudioService?         @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  artist                User                   @relation("ArtistAppointments", fields: [artistUserId], references: [id], onDelete: Restrict)
  history               AppointmentHistory[]
  payments              Payment[]
  financialTransactions FinancialTransaction[]
  stockMovements        StockMovement[]
  documentSignatures    DocumentSignature[]

  @@index([startAt, endAt])
  @@index([clientId])
  @@index([projectId])
  @@index([status])
}

model AppointmentHistory {
  id              String             @id @default(cuid())
  appointmentId   String
  changedByUserId String?
  previousStatus  AppointmentStatus?
  newStatus       AppointmentStatus
  previousStartAt DateTime?
  newStartAt      DateTime?
  reason          String?
  createdAt       DateTime           @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  changedBy   User?       @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([appointmentId])
}

model Reminder {
  id                String    @id @default(cuid())
  userId            String
  title             String
  description       String?
  dueAt             DateTime
  color             String    @default("default")
  completedAt       DateTime?
  relatedEntityType String?
  relatedEntityId   String?
  createdAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dueAt])
}

model NoteFolder {
  id        String       @id @default(cuid())
  userId    String
  name      String
  color     String       @default("champagne")
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes StudioNote[]

  @@unique([userId, name])
  @@index([userId, sortOrder])
}

model StudioNote {
  id        String   @id @default(cuid())
  userId    String
  folderId  String?
  title     String
  content   String   @default("")
  color     String   @default("default")
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder NoteFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([userId, isPinned, updatedAt])
  @@index([folderId])
}

model QuoteRequest {
  id                   String      @id @default(cuid())
  codeNumber           Int         @unique @default(autoincrement())
  clientId             String
  title                String
  ideaDescription      String
  style                String
  bodyRegion           String
  approxSizeCm         String
  availabilityText     String?
  clientNotes          String?
  referenceFileIds     String[]    @default([])
  status               QuoteStatus @default(NEW)
  quotedAmount         Decimal?    @db.Decimal(12, 2)
  depositAmount        Decimal?    @db.Decimal(12, 2)
  paymentTerms         String?
  validUntil           DateTime?
  adminNotes           String?
  respondedAt          DateTime?
  clientDecisionAt     DateTime?
  clientDecisionReason String?
  convertedProjectId   String?     @unique
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  client           Client         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  convertedProject TattooProject? @relation("QuoteToProject", fields: [convertedProjectId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([status])
}

model TattooProject {
  id                   String       @id @default(cuid())
  clientId             String
  name                 String
  description          String
  style                String
  bodyRegion           String
  approxSizeCm         String
  stage                ProjectStage @default(INITIAL_IDEA)
  negotiatedAmount     Decimal      @default(0) @db.Decimal(12, 2)
  depositAmount        Decimal      @default(0) @db.Decimal(12, 2)
  plannedSessions      Int          @default(1)
  aftercareGuidance    String?
  allowPublicPortfolio Boolean      @default(false)
  portfolioFeatured    Boolean      @default(false)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  client                Client                 @relation(fields: [clientId], references: [id], onDelete: Restrict)
  originQuote           QuoteRequest?          @relation("QuoteToProject")
  appointments          Appointment[]
  media                 ProjectMedia[]
  passport              TattooPassport?
  aftercareEntries      AftercareEntry[]
  payments              Payment[]
  financialTransactions FinancialTransaction[]
  stockMovements        StockMovement[]
  documentSignatures    DocumentSignature[]

  @@index([clientId])
  @@index([stage])
  @@index([allowPublicPortfolio])
}

model ProjectMedia {
  id                 String    @id @default(cuid())
  projectId          String
  fileId             String
  kind               MediaKind
  caption            String?
  isClientVisible    Boolean   @default(true)
  hasImageConsent    Boolean   @default(false)
  consentSignatureId String?
  createdAt          DateTime  @default(now())

  project TattooProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  file    StoredFile    @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([kind])
}

model TattooPassport {
  id                 String   @id @default(cuid())
  projectId          String   @unique
  clientId           String
  title              String
  completedDate      DateTime @db.Date
  style              String
  bodyRegion         String
  clientMeaning      String?
  sessionsCount      Int      @default(1)
  careSummary        String?
  touchUpHistoryJson Json     @default("[]")
  featuredFileId     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  project TattooProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client  Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model AftercareEntry {
  id                String          @id @default(cuid())
  projectId         String
  clientId          String
  dayNumber         Int
  clientObservation String
  artistFeedback    String?
  status            AftercareStatus @default(NORMAL)
  photoFileId       String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  project TattooProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client  Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([clientId])
}

model FutureTattooIdea {
  id               String   @id @default(cuid())
  clientId         String
  title            String
  description      String
  style            String
  bodyRegion       String?
  approxSizeCm     String?
  referenceFileIds String[] @default([])
  convertedQuoteId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model FinancialAccount {
  id             String           @id @default(cuid())
  ownerUserId    String
  context        FinancialContext
  name           String
  type           AccountType
  institution    String?
  initialBalance Decimal          @default(0) @db.Decimal(12, 2)
  currentBalance Decimal          @default(0) @db.Decimal(12, 2)
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  owner             User                   @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  transactions      FinancialTransaction[]
  linkedCreditCards CreditCard[]
  transfersOut      InternalTransfer[]     @relation("TransferFromAccount")
  transfersIn       InternalTransfer[]     @relation("TransferToAccount")
  goals             FinancialGoal[]

  @@index([ownerUserId, context])
}

model CreditCard {
  id              String           @id @default(cuid())
  ownerUserId     String
  context         FinancialContext
  name            String
  brand           String
  last4           String
  creditLimit     Decimal          @db.Decimal(12, 2)
  closingDay      Int
  dueDay          Int
  linkedAccountId String?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  owner         User                   @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  linkedAccount FinancialAccount?      @relation(fields: [linkedAccountId], references: [id], onDelete: SetNull)
  transactions  FinancialTransaction[]

  @@index([ownerUserId, context])
}

model FinancialCategory {
  id           String           @id @default(cuid())
  ownerUserId  String
  context      FinancialContext
  parentId     String?
  name         String
  kind         TransactionType
  monthlyLimit Decimal?         @db.Decimal(12, 2)
  isSystem     Boolean          @default(false)
  createdAt    DateTime         @default(now())

  owner        User                   @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  parent       FinancialCategory?     @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     FinancialCategory[]    @relation("CategoryTree")
  transactions FinancialTransaction[]

  @@index([ownerUserId, context, kind])
}

model FinancialTransaction {
  id                 String            @id @default(cuid())
  ownerUserId        String
  context            FinancialContext
  type               TransactionType
  description        String
  amount             Decimal           @db.Decimal(12, 2)
  competenceDate     DateTime          @db.Date
  dueDate            DateTime?         @db.Date
  paidAt             DateTime?
  status             TransactionStatus @default(PENDING)
  categoryId         String
  accountId          String?
  creditCardId       String?
  paymentMethod      PaymentMethod
  installmentGroupId String?
  installmentNumber  Int?
  totalInstallments  Int?
  recurrenceRule     String?
  appointmentId      String?
  projectId          String?
  paymentId          String?           @unique
  attachmentFileId   String?
  notes              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  owner       User              @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  category    FinancialCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  account     FinancialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  creditCard  CreditCard?       @relation(fields: [creditCardId], references: [id], onDelete: SetNull)
  appointment Appointment?      @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  project     TattooProject?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  payment     Payment?          @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([ownerUserId, context, competenceDate])
  @@index([status, dueDate])
  @@index([categoryId])
}

model InternalTransfer {
  id            String       @id @default(cuid())
  ownerUserId   String
  fromAccountId String
  toAccountId   String
  amount        Decimal      @db.Decimal(12, 2)
  transferDate  DateTime     @db.Date
  description   String
  transferKind  TransferKind @default(ACCOUNT_TRANSFER)
  notes         String?
  createdAt     DateTime     @default(now())

  owner       User             @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  fromAccount FinancialAccount @relation("TransferFromAccount", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount   FinancialAccount @relation("TransferToAccount", fields: [toAccountId], references: [id], onDelete: Restrict)

  @@index([ownerUserId, transferDate])
}

model FinancialGoal {
  id              String           @id @default(cuid())
  ownerUserId     String
  context         FinancialContext
  name            String
  targetAmount    Decimal          @db.Decimal(12, 2)
  currentAmount   Decimal          @default(0) @db.Decimal(12, 2)
  targetDate      DateTime?        @db.Date
  linkedAccountId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  owner         User              @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  linkedAccount FinancialAccount? @relation(fields: [linkedAccountId], references: [id], onDelete: SetNull)

  @@index([ownerUserId, context])
}

model Payment {
  id                String          @id @default(cuid())
  codeNumber        Int             @unique @default(autoincrement())
  clientId          String
  appointmentId     String?
  projectId         String?
  kind              PaymentKind
  method            PaymentMethod
  gatewayProvider   GatewayProvider @default(MANUAL)
  externalReference String?
  idempotencyKey    String          @unique
  amount            Decimal         @db.Decimal(12, 2)
  status            PaymentStatus   @default(PENDING)
  confirmedAt       DateTime?
  confirmedByUserId String?
  receiptFileId     String?
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  client               Client                @relation(fields: [clientId], references: [id], onDelete: Restrict)
  appointment          Appointment?          @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  project              TattooProject?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  confirmedBy          User?                 @relation("ConfirmedPayments", fields: [confirmedByUserId], references: [id], onDelete: SetNull)
  financialTransaction FinancialTransaction?

  @@index([clientId])
  @@index([status])
  @@index([externalReference])
}

model PaymentWebhookEvent {
  id             String          @id @default(cuid())
  provider       GatewayProvider
  eventId        String          @unique
  eventType      String
  payloadJson    Json
  signatureValid Boolean
  processedAt    DateTime?
  errorMessage   String?
  createdAt      DateTime        @default(now())
}

model Supplier {
  id          String      @id @default(cuid())
  name        String
  contactName String?
  phone       String?
  email       String?
  notes       String?
  createdAt   DateTime    @default(now())
  stockItems  StockItem[]
}

model StockItem {
  id         String    @id @default(cuid())
  supplierId String?
  name       String
  category   String
  unit       String
  currentQty Decimal   @default(0) @db.Decimal(12, 3)
  minQty     Decimal   @default(0) @db.Decimal(12, 3)
  unitCost   Decimal   @default(0) @db.Decimal(12, 2)
  batchCode  String?
  expiresAt  DateTime? @db.Date
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  supplier  Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  movements StockMovement[]

  @@index([category])
  @@index([expiresAt])
}

model StockMovement {
  id               String            @id @default(cuid())
  stockItemId      String
  type             StockMovementType
  quantity         Decimal           @db.Decimal(12, 3)
  unitCostSnapshot Decimal           @db.Decimal(12, 2)
  projectId        String?
  appointmentId    String?
  recordedByUserId String
  notes            String?
  createdAt        DateTime          @default(now())

  stockItem   StockItem      @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  project     TattooProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  appointment Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  recordedBy  User           @relation(fields: [recordedByUserId], references: [id], onDelete: Restrict)

  @@index([stockItemId])
  @@index([projectId])
  @@index([appointmentId])
}

model DocumentTemplate {
  id                String       @id @default(cuid())
  kind              DocumentKind
  title             String
  description       String?
  version           Int          @default(1)
  bodyMarkdown      String
  questionsJson     Json         @default("[]")
  requiresSignature Boolean      @default(true)
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  signatures DocumentSignature[]

  @@index([kind, isActive])
}

model DocumentSignature {
  id                  String       @id @default(cuid())
  templateId          String
  templateVersion     Int
  kind                DocumentKind
  clientId            String
  appointmentId       String?
  projectId           String?
  contentSnapshot     String
  contentHash         String
  answersJson         Json         @default("{}")
  typedSignatureName  String
  signatureFileId     String?
  signedAt            DateTime     @default(now())
  ipAddress           String?
  userAgent           String?
  createdAt           DateTime     @default(now())

  template    DocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  client      Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  appointment Appointment?     @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  project     TattooProject?   @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([clientId, kind])
}

model StoredFile {
  id               String         @id @default(cuid())
  uploadedByUserId String?
  clientId         String?
  storageKey       String         @unique
  originalName     String
  mimeType         String
  sizeBytes        Int
  visibility       FileVisibility @default(ADMIN_PRIVATE)
  createdAt        DateTime       @default(now())

  uploadedBy   User?          @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  client       Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  projectMedia ProjectMedia[]

  @@index([clientId])
  @@index([visibility])
}

model Coupon {
  id            String       @id @default(cuid())
  code          String       @unique
  description   String
  discountType  DiscountType
  discountValue Decimal      @db.Decimal(12, 2)
  maxUses       Int?
  usedCount     Int          @default(0)
  validUntil    DateTime?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())

  referrals Referral[]
}

model Referral {
  id                String         @id @default(cuid())
  referrerClientId  String
  referredName      String
  referredContact   String
  referredClientId  String?
  couponId          String?
  status            ReferralStatus @default(INVITED)
  rewardDescription String?
  createdAt         DateTime       @default(now())

  referrerClient Client  @relation("ReferrerClient", fields: [referrerClientId], references: [id], onDelete: Cascade)
  referredClient Client? @relation("ReferredClient", fields: [referredClientId], references: [id], onDelete: SetNull)
  coupon         Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)

  @@index([referrerClientId])
}

model GiftVoucher {
  id               String        @id @default(cuid())
  code             String        @unique
  purchaserName    String
  recipientName    String
  recipientContact String?
  amount           Decimal       @db.Decimal(12, 2)
  balance          Decimal       @db.Decimal(12, 2)
  validUntil       DateTime?
  status           VoucherStatus @default(ACTIVE)
  createdAt        DateTime      @default(now())
}

model ExclusiveFlashDesign {
  id               String      @id @default(cuid())
  title            String
  description      String?
  style            String
  suggestedRegion  String
  approxSizeCm     String
  price            Decimal     @db.Decimal(12, 2)
  imageFileId      String?
  status           FlashStatus @default(AVAILABLE)
  reservedClientId String?
  createdAt        DateTime    @default(now())

  reservedClient Client? @relation(fields: [reservedClientId], references: [id], onDelete: SetNull)

  @@index([status])
}

model WaitlistEntry {
  id             String         @id @default(cuid())
  clientId       String?
  name           String
  contact        String
  preferredStyle String
  preferredDays  String?
  notes          String?
  status         WaitlistStatus @default(WAITING)
  createdAt      DateTime       @default(now())

  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([status])
}

model MarketingCampaign {
  id          String   @id @default(cuid())
  title       String
  segment     String
  message     String
  channel     String
  targetCount Int      @default(0)
  status      String   @default("DRAFT")
  createdAt   DateTime @default(now())
}

model Notification {
  id              String              @id @default(cuid())
  recipientUserId String
  channel         NotificationChannel @default(IN_APP)
  eventType       String
  title           String
  body            String
  linkUrl         String?
  status          NotificationStatus  @default(UNREAD)
  readAt          DateTime?
  createdAt       DateTime            @default(now())

  recipient User @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, status])
  @@index([createdAt])
}

model NotificationChannelConfig {
  id                String              @id @default(cuid())
  provider          IntegrationProvider @unique
  isEnabled         Boolean             @default(false)
  isConfigured      Boolean             @default(false)
  configSummaryJson Json                @default("{}")
  updatedAt         DateTime            @updatedAt
}

model StudioSetting {
  id                      String   @id @default("studio-default")
  studioName              String   @default("ZANIMA TATTOO")
  ownerName               String   @default("Leticia Zanini Macalossi")
  instagramHandle         String   @default("@zanima_tattoo")
  whatsappNumber          String   @default("")
  email                   String   @default("")
  address                 String   @default("")
  cityState               String   @default("")
  defaultDepositPercent   Int      @default(30)
  defaultDepositFixed     Decimal? @db.Decimal(12, 2)
  cancellationPolicyHours Int      @default(48)
  acceptedPaymentMethods  String[] @default(["PIX", "CREDIT_CARD", "CASH"])
  heroHeadline            String   @default("Traços finos com intenção, leveza e permanência.")
  heroSubheadline         String   @default("Estúdio especializado em Fine Line, Floral e Minimalista por Leticia Zanini Macalossi.")
  bioText                 String   @default("Cada projeto nasce de escuta atenta, desenho autoral e técnica delicada para cicatrizar com precisão e elegância ao longo do tempo.")
  careBeforeJson          Json     @default("[]")
  careAfterJson           Json     @default("[]")
  faqJson                 Json     @default("[]")
  updatedAt               DateTime @updatedAt
}
